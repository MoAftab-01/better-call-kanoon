# Set these in the backend process environment. This template is not auto-loaded.
# Never place a real key in this tracked file or in VITE_* variables.
GROQ_API_KEY=
GROQ_MODEL=
# Local optional hybrid retrieval: explicit existing data-only model directory.
KANOON_EMBEDDING_MODEL_PATH=
# Production chat fails closed without a distinct access token of 32+ characters.
KANOON_ENV=local
KANOON_ACCESS_TOKEN=
KANOON_ALLOWED_ORIGINS=
# Local defaults. Production must use public + bm25, as in render.yaml.
CORPUS_KIND=private
RETRIEVAL_MODE=auto
PRIVATE_CORPUS_ROOT=
# Public mode fails closed unless both manifest and separate decision are pinned.
PUBLIC_CORPUS_DIR=
PUBLIC_CORPUS_MANIFEST_SHA256=
PUBLIC_CORPUS_APPROVAL_FILE=
PUBLIC_CORPUS_APPROVAL_SHA256=
