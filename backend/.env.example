# ---------------------------------------------------------------------------
# Better Call Kanoon - example environment file (BACKEND)
#
# This file now lives in `backend/`. Copy it to `.env` in the SAME directory,
# then fill in your own values. From `backend/`:
#
#     cp .env.example .env          # macOS / Linux / Git Bash
#     copy .env.example .env        # Windows PowerShell / cmd
#
# Or from the repository root:
#
#     cp backend/.env.example backend/.env
#     copy backend\.env.example backend\.env
#
# `.env` is git-ignored and must NEVER be committed; this example file is the
# only environment file that is tracked in version control. Never put a real
# API key in this file - only in your local `.env`.
#
# Every value below is optional. The application starts and `/api/health`
# reports "healthy" with no `.env` file at all. An empty GROQ_API_KEY simply
# means the model-backed features (later stages) stay switched off, which is
# why `llm_configured` reports false in `/api/config`.
# ---------------------------------------------------------------------------

# --- Application identity ---------------------------------------------------
APP_NAME=Better Call Kanoon
APP_TAGLINE=Your AI guide to Indian law.
APP_VERSION=0.1.0

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Comma-separated list of allowed origins, or * to allow any origin.
#
# During frontend development the Vite dev server runs on its own port and
# talks to this backend cross-origin, so list it explicitly rather than
# relying on "*":
#
#     CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# In production the frontend is BUILT (`npm run build` -> `frontend/dist`) and
# served by this same FastAPI process, so the browser sees one origin and this
# setting does not matter.
#
# The default below lists ONLY the local Vite dev server. Do not widen it to "*"
# on any deployment that is reachable from a network: with the wildcard, every
# website on the internet can read this API's responses from a victim's
# browser. Add your own domain explicitly if you ever need it.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Model provider (optional) ----------------------------------------------
# Leave GROQ_API_KEY EMPTY until you have a key. Create one at
# https://console.groq.com/keys and paste it into your local .env only.
GROQ_API_KEY=
# Leave GROQ_MODEL empty to let the application choose the provider default;
# no model id is ever hardcoded in the source.
GROQ_MODEL=

# --- Retrieval (Stage 3) ----------------------------------------------------
# How many results a search returns.
TOP_K=5
# Candidates pulled from each retriever before fusion reranks them.
# Not validated - there is no recall measurement behind the value.
CANDIDATE_MULTIPLIER=4
# Reciprocal-rank-fusion damping constant. 60 is the RRF paper's value and is
# NOT tuned for this corpus.
#
# There is deliberately no SEMANTIC_WEIGHT / BM25_WEIGHT here. Those existed
# for a weighted-sum fusion that measurement ruled out: cosine lives in
# [-1, 1] and BM25 is unbounded above, so a 0.65/0.35 blend gave the lexical
# side 77.8% of the score rather than 35%. Fusion is now by rank, which needs
# no weights. See README "Stage 3 — retrieval".
RRF_K=60

# --- Input limits and abuse guardrails -------------------------------------
MAX_INPUT_LENGTH=1000
RATE_LIMIT=20

# --- Languages --------------------------------------------------------------
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi

# --- Embeddings (used from Stage 3 onwards) --------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Logging ----------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Paths (relative to the backend root, i.e. this directory) --------------
# These directories are created on demand; the data/laws PDFs you download
# yourself are git-ignored.
DATA_DIR=data
# The built React app, one level ABOVE this directory at the repo root:
# <repo>/frontend/dist. Leave unset in normal use - the default already points
# there, and it only exists after `npm run build` has run in `frontend/`.
# STATIC_DIR=../frontend/dist
INDEX_DIR=data/index