# Dependencies
node_modules/

# Build output (the backend mounts frontend/dist in production)
dist/
dist-ssr/

# Vite / tooling caches
.vite/
*.local

# Test / coverage output
coverage/

# Editor directories and logs
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS noise
.DS_Store
Thumbs.db

# Environment files. The backend reads GROQ_API_KEY from the environment and
# never sends it to the browser, but a stray .env must still stay untracked.
.env
.env.*
!.env.example
