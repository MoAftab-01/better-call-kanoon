{
  "approval_required_for": [
    "corpus publication",
    "deployment",
    "push"
  ],
  "exclusions": [
    "backend/data/**",
    "docs/evidence/**",
    "private PDFs and processed records",
    "candidate corpus text until explicitly approved",
    "ML dependencies and weights"
  ],
  "runtime_files": [
    ".python-version",
    "backend/app/__init__.py",
    "backend/app/main.py",
    "backend/chat/__init__.py",
    "backend/chat/api.py",
    "backend/chat/models.py",
    "backend/chat/provider.py",
    "backend/chat/service.py",
    "backend/public_corpus/__init__.py",
    "backend/public_corpus/models.py",
    "backend/public_corpus/runtime.py",
    "backend/requirements-runtime.txt",
    "backend/retrieval/__init__.py",
    "backend/retrieval/configuration.py",
    "backend/retrieval/scoring.py",
    "render.yaml"
  ],
  "schema_version": 1,
  "scope": "Public-mode BM25 runtime source only. Corpus and publication decision are separate, explicitly reviewed artifacts. No private evidence code, audits or data."
}
