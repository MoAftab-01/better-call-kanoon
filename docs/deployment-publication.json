{
  "approval_required_for": [
    "corpus publication",
    "deployment",
    "push"
  ],
  "exclusions": [
    "backend/data/**",
    "docs/evidence/**",
    "private PDFs and processed records",
    "candidate corpus text until explicitly approved",
    "ML dependencies and weights"
  ],
  "runtime_files": [
    ".python-version",
    "backend/app/__init__.py",
    "backend/app/main.py",
    "backend/chat/__init__.py",
    "backend/chat/api.py",
    "backend/chat/models.py",
    "backend/chat/provider.py",
    "backend/chat/service.py",
    "backend/public_corpus/__init__.py",
    "backend/public_corpus/authorization.py",
    "backend/public_corpus/models.py",
    "backend/public_corpus/runtime.py",
    "backend/requirements-runtime.txt",
    "backend/retrieval/__init__.py",
    "backend/retrieval/configuration.py",
    "backend/retrieval/scoring.py",
    "render.yaml",
    "frontend/.vercelignore",
    "frontend/eslint.config.js",
    "frontend/index.html",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/scripts/check-hosted-env.mjs",
    "frontend/tsconfig.json",
    "frontend/vite.config.ts",
    "frontend/vercel.json",
    "frontend/src/App.tsx",
    "frontend/src/api.ts",
    "frontend/src/chat.ts",
    "frontend/src/components/Brand.tsx",
    "frontend/src/components/BrowserVoice.tsx",
    "frontend/src/components/ConnectionStatus.tsx",
    "frontend/src/components/ConversationWorkspace.tsx",
    "frontend/src/components/LegalDisclaimer.tsx",
    "frontend/src/components/Sidebar.tsx",
    "frontend/src/components/SourcePanel.tsx",
    "frontend/src/components/WelcomePanel.tsx",
    "frontend/src/hooks/useBackendHealth.ts",
    "frontend/src/hooks/useResearchStatus.ts",
    "frontend/src/main.tsx",
    "frontend/src/styles.css"
  ],
  "schema_version": 1,
  "scope": "No-corpus website source artifact: minimal public BM25 backend plus Vite frontend build sources. No private evidence, source text, approvals, test servers or generated assets."
}
